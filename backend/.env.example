# 源码部署和本地开发的配置：复制为 backend/.env 后填写（cp .env.example .env），在 backend/ 下运行 niulai 时读取。
# .env 含密码，不要提交。Docker 部署不用这个文件，用 deploy/.env.example。

# PostgreSQL（16 或以上），库要先建好
DATABASE_URL=postgres://user:password@127.0.0.1:5432/niulai

# 可选的 Redis 共享读取缓存；未启动 Redis 时服务仍可运行，只使用进程内缓存
# REDIS_URL=redis://127.0.0.1:6379

# 前端构建产物目录（在 frontend/ 下执行 pnpm build 生成）。设置后 niulai serve 在同一端口提供网页；
# 不设置时只提供 API（本地开发时前端用 pnpm dev）
# NIULAI_WEB_DIR=../frontend/dist

# 同花顺金融数据服务 API Key（在 https://fuyao.aicubes.cn/admin/ 生成）。可以不填，启动后在网页的首次登录引导中配置；
# 填了就优先使用这里的值，网页上不能修改
HITHINK_FINANCE_API_KEY=

# 以下可选，括号内为默认值
# NIULAI_API_BIND=127.0.0.1:8080       # 监听地址和端口
# NIULAI_API_TIMEOUT_S=300              # API 请求最长执行秒数（长任务可取消）
# NIULAI_WORKER_CONCURRENCY=3          # 同时执行的同步任务数
# NIULAI_RATE_LIMIT_RPS=2              # 供应商接口每秒请求数（同一时刻只有一个进程执行同步任务）
# NIULAI_SCHEDULER_ENABLED=true
# NIULAI_DATASETS_PATH=config/datasets.yaml
# NIULAI_LOG_FORMAT=json               # 结构化日志
# RUST_LOG=info
