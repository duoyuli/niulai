{
  "name": "niulai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "api:spec": "cd ../backend && cargo run -q --bin niulai -- openapi > ../frontend/openapi.json",
    "api:gen": "orval"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "orval": "8.41.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
