# Docker 部署的配置。复制为 .env（cp .env.example .env）后按需修改；下面都是可以直接使用的默认值。
# .env 含密码，不要提交。修改后执行 docker compose up -d 生效。

# ── 镜像 ──
# 建议固定版本号，例如 ghcr.io/duoyuli/niulai:0.1.0（对应 git 标签 v0.1.0）
NIULAI_IMAGE=ghcr.io/duoyuli/niulai:latest

# ── 端口 ──
# niulai 在宿主机上监听的地址和端口，页面和 API 都在这个端口上。端口被占用时改这里
NIULAI_LISTEN_ADDR=127.0.0.1
NIULAI_PORT=8080

# ── 数据库 ──
# 默认连接同一个 compose 中的内置 PostgreSQL；要用自己的数据库，把连接串换成它（PostgreSQL 16 或以上）
DATABASE_URL=postgres://niulai:niulai@postgres:5432/niulai
# 内置数据库的密码，要与上面连接串中的密码一致。只在第一次启动（创建数据卷）之前修改才生效
POSTGRES_PASSWORD=niulai
# 连接池上限
NIULAI_DB_MAX_CONNECTIONS=10

# ── 同步 ──
# 同时执行的同步任务数
NIULAI_WORKER_CONCURRENCY=3
# 每秒请求同花顺接口的次数
NIULAI_RATE_LIMIT_RPS=2
# 请求同花顺接口的超时秒数
NIULAI_HTTP_TIMEOUT_S=60
# 是否运行定时同步，以及每个交易日收盘后的触发时间（Asia/Shanghai，HH:MM）
NIULAI_SCHEDULER_ENABLED=true
NIULAI_SCHEDULE_AFTER_CLOSE=18:00

# ── 日志 ──
RUST_LOG=info,sqlx=warn,tower_http=info

# ── 同花顺 API Key ──
# 一般不在这里填：启动后第一次打开网页时按引导配置（在 https://fuyao.aicubes.cn/admin/ 生成）。
# 填了就优先使用这里的值，网页上不能修改
# HITHINK_FINANCE_API_KEY=
