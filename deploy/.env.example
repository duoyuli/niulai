# Docker 部署的配置：复制为 .env 后填写（cp .env.example .env）。.env 含密码，不要提交。
# 同花顺 API Key 不在这里填：启动后第一次打开网页时按引导配置（在 https://fuyao.aicubes.cn/admin/ 生成）。
# 其他可选的 NIULAI_* 变量（并发、限速、调度时间等）也可以写在这里，见 docs/interfaces/configuration.md。

# 镜像。服务器上建议固定版本号，例如 ghcr.io/duoyuli/niulai:0.1.0（对应 git 标签 v0.1.0）
NIULAI_IMAGE=ghcr.io/duoyuli/niulai:latest

# 内置数据库的密码（必填），自己生成一个：openssl rand -hex 16
POSTGRES_PASSWORD=

# niulai 在宿主机上监听的地址和端口。默认只监听本机；要从其他机器访问时改成 0.0.0.0:8080
NIULAI_LISTEN=127.0.0.1:8080

# 用已有的 PostgreSQL（16 或以上）时：把下面的 COMPOSE_PROFILES 改成空，并填写 DATABASE_URL
COMPOSE_PROFILES=db
# DATABASE_URL=postgres://user:pass@host:5432/niulai
