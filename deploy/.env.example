# 部署配置。install.sh 会据此生成 .env；也可以复制为 .env 后手工填写。.env 含密码，不要提交。
# 其他可选的 NIULAI_* 变量（并发、限速、调度时间等）也可以写在这里，见 docs/interfaces/configuration.md。

# 镜像：GitHub 镜像仓库里的地址。生产环境建议固定版本号（例如 :0.1.0，对应 git 标签 v0.1.0），升级时改这里再运行 upgrade.sh
NIULAI_IMAGE=ghcr.io/<github用户名>/niulai:latest

# 启用的服务：db（内置 PostgreSQL）、proxy（HTTPS + 登录）。只用 SSH 隧道访问时去掉 proxy；用已有数据库时去掉 db
COMPOSE_PROFILES=db,proxy

# 同花顺金融数据服务 API Key：一般不在这里填，第一次打开网页时按引导配置（在 https://fuyao.aicubes.cn/admin/ 生成）。
# 在这里设置时优先使用它，网页上不能修改。同一个 Key 不要同时在两台服务器上执行同步
# HITHINK_FINANCE_API_KEY=

# 内置数据库的密码（install.sh 随机生成）。用已有数据库时，改成那个库的连接串
POSTGRES_PASSWORD=
DATABASE_URL=postgres://niulai:<POSTGRES_PASSWORD>@postgres:5432/niulai

# 公网域名（启用 proxy 时必填），要解析到这台服务器
NIULAI_DOMAIN=

# 端口（可选）：niulai 在本机监听的端口；Caddy 的 HTTP、HTTPS 端口
# NIULAI_PORT=8080
# NIULAI_HTTP_PORT=80
# NIULAI_HTTPS_PORT=443
